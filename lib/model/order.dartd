// import 'sub_program.dart';
// import 'order_status.dart';

class Order {
  final int? id;
  final String orderNumber;
  final double weightKg;
  final double volumeM2;
  final double deliveryLatitude;
  final double deliveryLongitude;
  
  // Nullable string fields
  final String? deliveryAddress;
  final String? deliveryDescription;
  
  final OrderStatus status;
  final bool clientApproved;

  // Date fields
  final DateTime? estimatedDeliveryTime;
  final DateTime? actualDeliveryTime;
  final DateTime? clientApprovalTime;
  final DateTime? createdAt;
  final DateTime? updatedAt;

  // Relational data
  final Client? client;
  final DeliveryProgram? deliveryProgram;
  final SubProgram? subProgram;

  // The JTS Point is usually serialized as a GeoJSON map (e.g., {"type": "Point", "coordinates": [lng, lat]}).
  // Since you already have distinct lat/lng doubles, you can keep this as a generic Map or ignore it entirely.
  final Map<String, dynamic>? deliveryLocation;

  Order({
    this.id,
    required this.orderNumber,
    required this.weightKg,
    required this.volumeM2,
    required this.deliveryLatitude,
    required this.deliveryLongitude,
    this.deliveryAddress,
    this.deliveryDescription,
    this.status = OrderStatus.pending,
    this.clientApproved = false,
    this.estimatedDeliveryTime,
    this.actualDeliveryTime,
    this.clientApprovalTime,
    this.createdAt,
    this.updatedAt,
    this.client,
    this.deliveryProgram,
    this.subProgram,
    this.deliveryLocation,
  });

  factory Order.fromJson(Map<String, dynamic> json) {
    return Order(
      id: json['id'] as int?,
      orderNumber: json['orderNumber'] ?? json['order_number'] ?? '',
      
      // Safe parsing for numeric types (handles both int and double from JSON)
      weightKg: (json['weightKg'] ?? json['weight_kg'] ?? 0).toDouble(),
      volumeM2: (json['volumeM2'] ?? json['volume_m2'] ?? 0).toDouble(),
      deliveryLatitude: (json['deliveryLatitude'] ?? json['delivery_latitude'] ?? 0).toDouble(),
      deliveryLongitude: (json['deliveryLongitude'] ?? json['delivery_longitude'] ?? 0).toDouble(),
      
      deliveryAddress: json['deliveryAddress'] ?? json['delivery_address'],
      deliveryDescription: json['deliveryDescription'] ?? json['delivery_description'],
      
      status: OrderStatus.fromJson(json['status']),
      clientApproved: json['clientApproved'] ?? json['client_approved'] ?? false,

      // Date Parsing
      estimatedDeliveryTime: _parseDate(json['estimatedDeliveryTime'] ?? json['estimated_delivery_time']),
      actualDeliveryTime: _parseDate(json['actualDeliveryTime'] ?? json['actual_delivery_time']),
      clientApprovalTime: _parseDate(json['clientApprovalTime'] ?? json['client_approval_time']),
      createdAt: _parseDate(json['createdAt'] ?? json['created_at']),
      updatedAt: _parseDate(json['updatedAt'] ?? json['updated_at']),

      // Relations
      client: json['client'] != null ? Client.fromJson(json['client']) : null,
      deliveryProgram: json['deliveryProgram'] ?? json['delivery_program'] != null 
          ? DeliveryProgram.fromJson(json['deliveryProgram'] ?? json['delivery_program']) 
          : null,
      subProgram: json['subProgram'] ?? json['sub_program'] != null 
          ? SubProgram.fromJson(json['subProgram'] ?? json['sub_program']) 
          : null,
          
      // JTS Geometry Point (usually a nested map)
      deliveryLocation: json['deliveryLocation'] ?? json['delivery_location'],
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'id': id,
      'orderNumber': orderNumber,
      'weightKg': weightKg,
      'volumeM2': volumeM2,
      'deliveryLatitude': deliveryLatitude,
      'deliveryLongitude': deliveryLongitude,
      'deliveryAddress': deliveryAddress,
      'deliveryDescription': deliveryDescription,
      'status': status.value, // Sends 'PENDING', 'ASSIGNED', etc.
      'clientApproved': clientApproved,
      
      'estimatedDeliveryTime': estimatedDeliveryTime?.toIso8601String(),
      'actualDeliveryTime': actualDeliveryTime?.toIso8601String(),
      'clientApprovalTime': clientApprovalTime?.toIso8601String(),
      'createdAt': createdAt?.toIso8601String(),
      'updatedAt': updatedAt?.toIso8601String(),
      
      'client': client?.toJson(),
      'deliveryProgram': deliveryProgram?.toJson(),
      'subProgram': subProgram?.toJson(),
      'deliveryLocation': deliveryLocation,
    };
  }

  /// Helper method to keep fromJson clean
  static DateTime? _parseDate(dynamic dateStr) {
    if (dateStr == null) return null;
    return DateTime.tryParse(dateStr.toString());
  }
}